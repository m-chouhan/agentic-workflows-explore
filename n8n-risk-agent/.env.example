# ─────────────────────────────────────────────
# n8n Risk Factor Agent — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Postgres ──────────────────────────────────
POSTGRES_USER=riskagent
POSTGRES_PASSWORD=riskagent_pass
POSTGRES_DB=risk_factor

# ── n8n ───────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# IMPORTANT: Generate with: openssl rand -hex 20
N8N_ENCRYPTION_KEY=change_me_in_production_32chars_min

# Timezone for schedule trigger (daily 3 AM will use this)
TIMEZONE=Asia/Kolkata

# ── News API — Finnhub ─────────────────────────
# Sign up free at https://finnhub.io → Dashboard → API Key
# Free tier: 60 requests/min, market news + company news included
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── LLM — Google Gemini ────────────────────────
# Reuse same key from DBOS platform
# Model: gemini-2.5-flash (or gemini-2.0-flash for lower quota usage)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# ── Telegram ──────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → follow prompts → copy token
# Step 2: Start a chat with your new bot, then run:
#   curl https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   Look for "chat":{"id": <number>} — that's your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
