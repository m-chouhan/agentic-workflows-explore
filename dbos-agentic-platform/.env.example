# Copy to .env and adjust if needed.

# ── App server ────────────────────────────────────────────────────
PORT=3000

# ── Postgres (shared between server + worker — DBOS system state) ─
PGHOST=localhost
PGPORT=5432
PGUSER=dbos
PGPASSWORD=dbos
PGDATABASE=dbos_sales

# ── Worker config ─────────────────────────────────────────────────
# Unique ID per process/pod. In K8s use Downward API (metadata.name).
# Without Conductor, ONLY the process with this ID recovers its own
# PENDING workflows on restart.
DBOS_EXECUTOR_ID=worker-local

# Queue names — must match constants in src/worker.ts
ANALYSIS_QUEUE_NAME=analysis-queue
VULN_QUEUE_NAME=vuln-queue

# ── Google Gemini ─────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-key
GOOGLE_MODEL=gemini-2.0-flash

# ── GitHub (vuln fix PoC — PR creation) ───────────────────────────
# For local dev: use a PAT with repo scope.
# For production: use GitHub App (see src/github/octokit.ts).
GITHUB_TOKEN=ghp_your-personal-access-token
