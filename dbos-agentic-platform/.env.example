# Template for `.env` — the ONLY env file the app reads.
# Copy to .env and fill in secrets:  cp .env.example .env
# Per-environment configs live in .env.local / .env.stg / .env.prod (gitignored);
# select one by copying it over .env before starting the app.
PORT=3000

# DBOS Postgres (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5432
PGUSER=dbos
PGPASSWORD=dbos
PGDATABASE=dbos_platform

# Model
GOOGLE_MODEL=gemini-2.5-flash

# Secrets
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
BITBUCKET_TOKEN=your-bitbucket-access-token
# GITHUB_TOKEN=ghp_your-personal-access-token
