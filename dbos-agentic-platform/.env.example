# Copy to .env and adjust if needed.
PORT=3000

# DBOS Postgres (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5432
PGUSER=dbos
PGPASSWORD=dbos
PGDATABASE=dbos_platform

# Google Gemini (required for LLM agents)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash-preview-04-17
# Optional: GitHub PAT with repo scope (enables PR creation in vuln workflow)
# GITHUB_TOKEN=ghp_your-personal-access-token
