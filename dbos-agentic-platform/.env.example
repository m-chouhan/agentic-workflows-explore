# ── Postgres (shared: DBOS system state + business data) ─────────
PGHOST=localhost
PGPORT=5432
PGUSER=dbos
PGPASSWORD=dbos
PGDATABASE=dbos_platform

# ── App server ────────────────────────────────────────────────────
PORT=3000

# ── Worker ────────────────────────────────────────────────────────
# Unique ID per process/pod. In K8s use Downward API (metadata.name).
DBOS_EXECUTOR_ID=worker-local

# ── Google Gemini (required for LLM agents) ──────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your-key
# If gemini-2.0-flash shows quota 0, try gemini-flash-latest
GOOGLE_MODEL=gemini-2.5-flash-preview-04-17
# ── GitHub (optional — enables PR creation in vuln workflow) ─────
# PAT with repo scope for dev; use GitHub App for production.
# GITHUB_TOKEN=ghp_your-personal-access-token
