{
  "name": "dbos-agentic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DBOS-orchestrated agentic workflows: sales insights (PoC #1) + vulnerability scan-and-fix (PoC #2)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev": "npm run dev:worker",
    "start:worker": "node dist/src/worker.js",
    "start:server": "node dist/src/server.js",
    "seed": "tsx scripts/seed-sales.ts",
    "dbos:migrate": "npx dbos migrate",
    "dbos:reset": "npx dbos reset --yes"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.71",
    "@ai-sdk/openai": "^3.0.63",
    "@dbos-inc/dbos-sdk": "^4.17.6",
    "ai": "^6.0.177",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "@octokit/rest": "^21.1.1",
    "pg": "^8.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
