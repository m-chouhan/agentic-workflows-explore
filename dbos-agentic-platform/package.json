{
  "name": "dbos-agentic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "DBOS-orchestrated agentic workflows: vulnerability scan-and-fix pipeline",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/**/*.sql\" dist/src",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:server": "tsx watch src/server.ts",
    "start:worker": "node dist/src/worker.js",
    "start:server": "node dist/src/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "jest --selectProjects unit int",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit int --coverage",
    "test:e2e": "jest --selectProjects e2e",
    "test:all": "jest",
    "stack:up": "./scripts/run-local.sh",
    "stack:up:rebuild": "./scripts/run-local.sh --rebuild",
    "stack:down": "./scripts/stop-local.sh",
    "stack:logs": "./scripts/logs.sh"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.71",
    "@ai-sdk/openai": "^3.0.63",
    "@dbos-inc/dbos-sdk": "^4.17.6",
    "@octokit/rest": "^21.1.1",
    "ai": "^6.0.177",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pg": "^8.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
