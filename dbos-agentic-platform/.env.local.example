# ════════════════════════════════════════════════════════════════
#  Local Docker Stack — Environment Variables
#  Copy this file to .env.local and fill in your values.
#
#  Usage:
#    ./start-local.sh            — start stack (auto-creates this file on first run)
#    docker compose --env-file .env.local up --build   — manual equivalent
# ════════════════════════════════════════════════════════════════

# ── Required: Google Gemini API Key ─────────────────────────────────────────
# Get one at: https://aistudio.google.com/app/apikey (free tier available)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# ── LLM Model (default is fine, change if you want a different model) ────────
GOOGLE_MODEL=gemini-2.5-flash-preview-04-17

# ── Optional: GitHub PAT for PR creation in vuln workflow ───────────────────
# Create at: https://github.com/settings/tokens  (needs 'repo' scope)
# Only needed if you want the vuln scanner to create draft PRs on GitHub.
# GITHUB_TOKEN=ghp_your-personal-access-token

# ── Bitbucket Cloud HTTP access token (Bearer) ──────────────────────────────
# Repo/workspace access token. Required for the bitbucketPrStatus workflow.
# BITBUCKET_TOKEN=your-bitbucket-access-token
