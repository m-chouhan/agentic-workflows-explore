{
  "name": "poc-dbos-sales",
  "version": "0.1.0",
  "private": true,
  "description": "PoC #1: DBOS-orchestrated sales insights workflow (Express + SQLite + mock agent)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev": "npm run dev:worker",
    "start:worker": "node dist/src/worker.js",
    "start:server": "node dist/src/server.js",
    "seed": "tsx scripts/seed-sales.ts",
    "dbos:migrate": "npx dbos migrate",
    "dbos:reset": "npx dbos reset --yes"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^4.17.6",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
