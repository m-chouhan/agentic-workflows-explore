# Copy to .env and adjust if needed.

# ── App server ────────────────────────────────────────────────────
PORT=3000

# ── Postgres (shared between server + worker — DBOS system state) ─
PGHOST=localhost
PGPORT=5432
PGUSER=dbos
PGPASSWORD=dbos
PGDATABASE=dbos_sales

# ── SQLite (business data: sales rows + insights output) ──────────
SQLITE_PATH=./data/sales.db

# ── Worker config ─────────────────────────────────────────────────
# Unique ID per process/pod. In K8s use Downward API (metadata.name).
# Without Conductor, ONLY the process with this ID recovers its own
# PENDING workflows on restart.
DBOS_EXECUTOR_ID=worker-local

# Queue name — must match the constant in src/worker.ts
ANALYSIS_QUEUE_NAME=analysis-queue
